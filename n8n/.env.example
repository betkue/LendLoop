# Copy to n8n/.env. Never commit n8n/.env.
# The two HMAC secrets must match the Convex deployment:
#   npx convex env set HMAC_SECRET_CONVEX_TO_N8N <value>
#   npx convex env set HMAC_SECRET_N8N_TO_CONVEX <value>
# Generate each one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

HMAC_SECRET_CONVEX_TO_N8N=
HMAC_SECRET_N8N_TO_CONVEX=

# Encrypts the credentials n8n stores (e.g. the SMTP connection).
N8N_ENCRYPTION_KEY=

# Convex HTTP actions URL as seen from the n8n container (local Convex backend on the host).
CONVEX_SITE_URL=http://host.docker.internal:3211

# Time zone of the daily reminder (runs at 8:00).
GENERIC_TIMEZONE=Africa/Douala
